+// One signal per observed normalized scalar, shared across selections and query
+// instances. The registry contains only cells retained by active result owners.
+class CacheSignals {
+	readonly cells = new Map<string, Map<string, Scalar>>()
+	epoch = -1
+	constructor(readonly cache: Cache) {}
+	acquire(
+		owner: CacheView,
+		record: string,
+		fieldKey: string,
+		field: Field,
+		variables: {} | null | undefined,
+		seed: unknown,
+		seeded: boolean
+	) {
+		let fields = this.cells.get(record)
+		if (!fields) this.cells.set(record, (fields = new Map()))
+		let scalar = fields.get(fieldKey)
+		if (!scalar) {
+			scalar = new Scalar(this, record, fieldKey, field, variables, seed, seeded)
+			fields.set(fieldKey, scalar)
+		}
+		if (!owner.retained.has(scalar)) {
+			owner.retained.add(scalar)
+			scalar.refs++
+		}
+		return scalar
+	}
+	release(scalar: Scalar) {
+		if (--scalar.refs) return
+		const fields = this.cells.get(scalar.record)!
+		fields.delete(scalar.fieldKey)
+		if (!fields.size) this.cells.delete(scalar.record)
+	}
+	update(update: CacheUpdate) {
+		const epoch = this.cache.getEpoch()
+		if (this.epoch === epoch) return
+		this.epoch = epoch
+		if (update.fields) {
+			for (const { record, key } of update.fields) this.cells.get(record)?.get(key)?.update()
+		} else {
+			for (const fields of this.cells.values())
+				for (const scalar of fields.values()) scalar.update()
+		}
+	}
+}
+
+type Child = { snapshot: any; value: any }
+class RecordView {
+	readonly value: any
+	readonly children = new Map<string, Child>()
+	readonly scalars = new Map<string, Scalar>()
+	generation: number
+	record: NonNullable<ReturnType<typeof getRecordSelection>>
+	constructor(
+		readonly owner: CacheView,
+		public snapshot: any
+	) {
+		this.generation = owner.generation
+		this.record = getRecordSelection(snapshot)!
+		const names = Object.keys(snapshot)
+		const shape = JSON.stringify(names)
+		let shapeDescriptors = descriptors.get(shape)
+		if (!shapeDescriptors) {
+			shapeDescriptors = Object.create(null) as PropertyDescriptorMap
+			for (const name of names)
+				shapeDescriptors[name] = {
+					enumerable: true,
+					get() {
+						return nodes.get(this)!.read(name)
+					},
+					set: reject,
+				}
+			if (descriptors.size >= 128) descriptors.clear()
+			descriptors.set(shape, shapeDescriptors)
+		}
