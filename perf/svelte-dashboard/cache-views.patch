+import type { Cache } from 'houdini/runtime/cache'
+import {
+	getRecordIdentity,
+	getRecordSelection,
+	setRecordIdentity,
+} from 'houdini/runtime/cache/identity'
+import { evaluateKey } from 'houdini/runtime/cache/stuff'
+import type { CacheUpdate, CacheViewReference } from 'houdini/runtime/cache/updates'
+import { deepEquals } from 'houdini/runtime/deepEquals'
+import type { SubscriptionSelection } from 'houdini/runtime/types'
+import { untrack } from 'svelte'
+import { SvelteMap } from 'svelte/reactivity'
+import { project, reconcile } from './projection.svelte.js'
+import { cell, type Cell } from './cell.svelte.js'
+import { capture, isContainer, type ResultKey } from './snapshot.js'
+
+type Field = NonNullable<SubscriptionSelection['fields']>[string]
+const key: ResultKey = () => undefined
+const owns = Object.prototype.hasOwnProperty
+const registries = new WeakMap<Cache, CacheSignals>()
+const nodes = new WeakMap<object, RecordView>()
+const descriptors = new Map<string, PropertyDescriptorMap>()
+const reject = () => {
+	throw new TypeError(
+		'Reactive results are readonly. Use a mutation or cache.write() to update data.'
+	)
+}
+
+class Scalar {
+	refs = 0
+	raw: unknown
+	snapshot: unknown
+	value: unknown
+	readonly cell: Cell
+	constructor(
+		readonly signals: CacheSignals,
+		readonly record: string,
+		readonly fieldKey: string,
+		readonly field: Field,
+		readonly variables: {} | null | undefined,
+		seed: unknown,
+		seeded: boolean
+	) {
+		this.raw =
+			seeded &&
+			(seed === null || typeof seed !== 'object') &&
+			!signals.cache._internal_unstable.config.scalars?.[field.type]?.unmarshal
+				? seed
+				: signals.cache._internal_unstable.storage.get(record, fieldKey).value
+		this.snapshot = capture(seeded ? seed : this.read())
+		this.value = project(this.snapshot)
+		this.cell = cell(this.value)
+	}
+	read() {
+		const result = this.signals.cache.read({
+			parent: this.record,
+			variables: this.variables,
+			selection: { fields: { value: { ...this.field, visible: true } } },
+		})
+		return result.data?.value ?? null
+	}
+	update() {
+		const raw = this.signals.cache._internal_unstable.storage.get(
+			this.record,
+			this.fieldKey
+		).value
+		if (Object.is(raw, this.raw)) return
+		this.raw = raw
+		const snapshot = capture(this.read())
+		this.value = reconcile(this.value, this.snapshot, snapshot, key)
+		this.snapshot = snapshot
+		this.cell.value = this.value
+	}
+}
