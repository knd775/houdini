+export class Cell {
+	value: unknown
+	constructor(value: unknown) {
+		this.value = $state.raw(value)
+	}
+}
+export function cell(value: unknown): Cell {
+	let result!: Cell
+	// Cell lifetime belongs to the cache view, not the derived that first reads it.
+	const stop = $effect.root(() => {
+		result = new Cell(value)
+	})
+	stop()
+	return result
+}
