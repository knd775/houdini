+			this.value,
+			record.id,
+			record.selection,
+			record.variables,
+			record.hasNullBubble
+		)
+	}
+	read(name: string): unknown {
+		if (this.generation !== this.owner.generation) {
+			this.scalars.clear()
+			this.generation = this.owner.generation
+		}
+		const cached = this.scalars.get(name)
+		if (cached && this.owner.active) return cached.cell.value
+		const linked = this.children.get(name)
+		if (linked) return this.owner.children.get(linked)
+		const record = this.record
+		const field = record.selection?.fields?.[name]
+		if (field && !field.selection) {
+			if (!this.owner.active)
+				return this.owner.readInactive(record.id, field, record.variables)
+			let scalar = this.scalars.get(name)
+			if (!scalar || !this.owner.retained.has(scalar)) {
+				scalar = untrack(() =>
+					this.owner.signals.acquire(
+						this.owner,
+						record.id,
+						evaluateKey(field.keyRaw, record.variables),
+						field,
+						record.variables,
+						this.snapshot[name],
+						this.owner.seedEpoch === this.owner.cache.getEpoch()
+					)
+				)
+				this.scalars.set(name, scalar)
+			}
+			return scalar.cell.value
+		}
+		let child = this.children.get(name)
+		if (!child) {
+			child = untrack(() => {
+				const snapshot = this.snapshot[name]
+				const child = { snapshot, value: this.owner.wrap(snapshot) }
+				this.owner.children.set(child, child.value)
+				return child
+			})
+			this.children.set(name, child)
+		}
+		return this.owner.children.get(child)
+	}
+	update(snapshot: any) {
+		this.snapshot = snapshot
+		this.record = getRecordSelection(snapshot)!
+		for (const [name, child] of this.children) {
+			const value = this.owner.reconcile(child.value, child.snapshot, snapshot[name])
+			child.snapshot = snapshot[name]
+			child.value = value
+			this.owner.children.set(child, value)
+		}
+	}
+}
