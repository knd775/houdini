+/** A selected cache view. It builds only the records and fields actually read. */
+export class CacheView {
+	readonly signals: CacheSignals
+	readonly retained = new Set<Scalar>()
+	readonly children = new SvelteMap<Child, unknown>()
+	private snapshot: any
+	private value: any
+	seedEpoch: number
+	generation = 0
+	active: boolean
+	constructor(
+		readonly cache: Cache,
+		readonly reference: CacheViewReference,
+		active: boolean
+	) {
+		this.active = active
+		let signals = registries.get(cache)
+		if (!signals) registries.set(cache, (signals = new CacheSignals(cache)))
+		this.signals = signals
+		this.seedEpoch = reference.epoch
+		this.snapshot = reference.snapshot()
+		this.value = this.wrap(this.snapshot)
+	}
+	matches(update: CacheUpdate) {
+		const reference = update.view!
+		return (
+			this.cache === update.cache &&
+			this.reference.selection === reference.selection &&
+			this.reference.parent === reference.parent &&
+			this.reference.ignoreMasking === reference.ignoreMasking &&
+			deepEquals(this.reference.variables, reference.variables)
+		)
+	}
+	update(update: CacheUpdate) {
+		this.signals.update(update)
+		if (!update.scalarOnly) {
+			const snapshot = update.view!.snapshot()
+			this.seedEpoch = update.view!.epoch
+			this.value = this.reconcile(this.value, this.snapshot, snapshot)
+			this.snapshot = snapshot
+		}
+		return this.value
+	}
+	get current() {
+		return this.value
+	}
+	activate() {
+		this.active = true
+	}
+	deactivate() {
+		this.generation++
+		this.active = false
+		for (const scalar of this.retained) this.signals.release(scalar)
+		this.retained.clear()
+	}
+	readInactive(record: string, field: Field, variables: {} | null | undefined) {
+		return project(
+			capture(
+				this.cache.read({
+					parent: record,
+					variables,
+					selection: { fields: { value: { ...field, visible: true } } },
+				}).data?.value ?? null
+			)
+		)
+	}
+	wrap(snapshot: any): any {
+		if (!isContainer(snapshot)) return capture(snapshot)
+		if (Array.isArray(snapshot))
+			return this.array(snapshot, (name) => this.wrap((snapshot as any)[name]))
+		if (getRecordSelection(snapshot)?.selection) return new RecordView(this, snapshot).value
+		return project(capture(snapshot))
+	}
+	private array(snapshot: any[], read: (name: string) => unknown) {
+		const result: any = new Array(snapshot.length)
+		for (const name of Object.keys(snapshot)) {
+			if (name === '__proto__')
+				Object.defineProperty(result, name, { value: read(name), enumerable: true })
+			else result[name] = read(name)
+		}
+		return Object.freeze(result)
+	}
+	reconcile(current: any, previous: any, next: any): any {
+		if (Object.is(previous, next)) return current
+		if (
+			!isContainer(previous) ||
+			!isContainer(next) ||
+			!isContainer(current) ||
+			Array.isArray(previous) !== Array.isArray(next)
+		)
+			return this.wrap(next)
+		if (Array.isArray(next) && Array.isArray(previous)) {
+			const byKey = new Map<string, number[]>()
+			previous.forEach((item, index) => {
+				const id = item && typeof item === 'object' ? getRecordIdentity(item) : undefined
+				if (id !== undefined) {
+					const indices = byKey.get(id) ?? []
+					indices.push(index)
+					byKey.set(id, indices)
+				}
+			})
+			let changed =
+				next.length !== previous.length ||
+				Object.keys(next).length !== Object.keys(previous).length
+			const result = this.array(next, (name) => {
+				const item = (next as any)[name]
+				const id = item && typeof item === 'object' ? getRecordIdentity(item) : undefined
+				const index =
+					/^(0|[1-9]\d*)$/.test(name) && id !== undefined ? byKey.get(id)?.shift() : name
+				const value =
+					index !== undefined && owns.call(previous, index)
+						? this.reconcile((current as any)[index], (previous as any)[index], item)
+						: this.wrap(item)
+				if (!owns.call(previous, name) || (current as any)[name] !== value) changed = true
+				return value
+			})
+			return changed ? result : current
+		}
+		const node = nodes.get(current)
+		if (!node) return reconcile(current, previous, next, key)
+		if (
+			getRecordIdentity(previous) !== getRecordIdentity(next) ||
+			Object.keys(previous).length !== Object.keys(next).length ||
+			Object.keys(next).some((name) => !owns.call(previous, name))
+		)
+			return this.wrap(next)
+		node.update(next)
+		return current
+	}
+}
